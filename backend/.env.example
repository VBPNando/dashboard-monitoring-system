# Contoh pengaturan opsional. Salin menjadi "backend/.env" lalu ubah seperlunya.
# Semua baris boleh dibiarkan dikomentari: aplikasi tetap jalan dengan nilai bawaan.
# Setelah mengubah, nyalakan ulang server (menu.bat -> 3).

# Port aplikasi (di Windows lebih mudah lewat menu.bat -> 8)
# PORT=3000

# Riwayat: per menit (hari) dan per jam + riwayat alert (hari)
# DBMON_HISTORY_MINUTE_DAYS=31
# DBMON_HISTORY_DAYS=400

# Login: lama "Ingat saya" (hari) dan login biasa (jam)
# DBMON_REMEMBER_DAYS=30
# DBMON_SESSION_HOURS=12

# Batasi host yang boleh didaftarkan (pisahkan dengan koma). Kosong = semua.
# DBMON_ALLOWED_HOSTS=192.168.1.*,10.0.*

# Memaksa password login dari file ini (fitur ganti password di aplikasi jadi nonaktif)
# DBMON_ADMIN_PASSWORD=

# Interval ambil metrik database (ms)
# DBMON_INTERVAL_MS=1000

# Hanya bila reverse proxy berada di komputer LAIN (Cloudflare Tunnel di komputer yang sama: tidak perlu)
# DBMON_TRUST_PROXY=1
# DBMON_SECURE_COOKIE=1
